{
  "name": "sengkrep",
  "version": "5.5.0",
  "description": "A reliability layer for web scraping in Node.js: unified HTTP/1.1 + HTTP/2 transport, coherent browser fingerprints, adaptive throttling, schema validation, selector health monitoring, content dedup, circuit breaker, resumable crawling, distributed queues, pluggable storage, robots.txt compliance, network capture (DevTools Protocol, HAR, local proxy, Playwright), and full TypeScript definitions.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "bin",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "sengkrep": "./bin/sengkrep.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rynaqrtz/sengkrep.git"
  },
  "homepage": "https://github.com/rynaqrtz/sengkrep#readme",
  "bugs": {
    "url": "https://github.com/rynaqrtz/sengkrep/issues"
  },
  "keywords": [
    "web-scraping",
    "scraper",
    "reliability",
    "typescript",
    "schema-validation",
    "schema-inference",
    "diff-detection",
    "health-monitor",
    "fingerprint",
    "retry",
    "cache",
    "cookie-jar",
    "proxy-rotation",
    "rate-limiter",
    "interceptors",
    "json-extraction",
    "http2",
    "circuit-breaker",
    "crawler",
    "distributed-queue",
    "network-capture",
    "har",
    "devtools-protocol",
    "cdp",
    "api-discovery",
    "robots-txt",
    "charset",
    "json-ld",
    "microdata",
    "simhash",
    "content-dedup",
    "adaptive-throttling",
    "prometheus",
    "sqlite",
    "compliance"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "coverage": "c8 --reporter=text --reporter=text-summary node test/run-all.js",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/bench.js",
    "example": "node example.js"
  },
  "author": "qrtz",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^10.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
